# ==========================================
# Sikelas Frontend Production Config (.env)
# ==========================================

# URL Base API Backend Node.js
# Contoh jika memakai domain dengan subdomain API:
# VITE_API_BASE_URL=https://api.sikelas.online/api

# Contoh jika backend dan frontend disatukan dalam satu domain melalui reverse proxy Nginx (/api):
# VITE_API_BASE_URL=https://sikelas.online/api

# Default untuk pengujian lokal:
VITE_API_BASE_URL=http://localhost:5000/api
